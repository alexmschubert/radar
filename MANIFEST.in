include LICENSE README.md RADAR_logo.png pyproject.toml
recursive-include src/radar *.py
recursive-include configs *.json
recursive-include docs *.md
recursive-include scripts *.py *.sh
recursive-include tests *.py
recursive-include examples *.py *.md
include examples/custom_data/example_encounters.csv
prune build
prune dist
prune data
prune prepared
prune runs
prune outputs
prune demo_run
global-exclude *.py[cod] *.pt *.pth *.pkl *.pickle *.npy *.npz
global-exclude *.csv.gz *.parquet *.parq *.safetensors .env .env.* *.pem *.key
global-exclude *.zip *[gG][eE][mM]*.txt
